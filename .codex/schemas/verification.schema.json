{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/multica-ai/andrej-karpathy-skills/.codex/schemas/verification.schema.json",
  "title": "Verification Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "checks", "residualRisk"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed", "skipped"] },
          "notes": { "type": "string" }
        }
      }
    },
    "residualRisk": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
